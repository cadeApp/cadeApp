# ==============================================================================
# cadeApp — Variables de Entorno (.env.example) · v2.5
# ==============================================================================
#
# INSTRUCCIONES DE USO:
# 1. Copiá este archivo como .env.local:
#    cp .env.example .env.local
# 2. Para desarrollo local con Docker (Supabase local), los valores por defecto
#    ya coinciden con la salida estándar de `pnpm supabase status`.
# 3. NUNCA subas .env.local ni expongas claves privadas/service_role al repositorio.
#    El hook de seguridad PreToolUse (agent-guard) y CI bloquean commits con secretos.
# 4. En producción y staging, las variables privadas se configuran en los
#    GitHub Environments y en la consola del hosting (Vercel / Supabase).
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. ENTORNO Y URL DE LA APLICACIÓN
# ------------------------------------------------------------------------------
# Entorno de ejecución: 'development' | 'test' | 'production'
NODE_ENV=development

# URL base canónica de la app (para redirecciones de Auth, PWA, SEO y callbacks).
# Local: http://localhost:3000
# Staging: https://staging.cadeapp.com
# Producción: https://cadeapp.com
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 2. SUPABASE (BaaS: Postgres, Auth, Storage, Realtime)
# ------------------------------------------------------------------------------
# URL del proyecto Supabase.
# Local (Docker): http://127.0.0.1:54321
# Staging / Prod: https://<project-id>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321

# Clave pública anónima (JWT con rol 'anon'). Segura para el navegador.
# Protegida por Row Level Security (RLS).
# (Valor por defecto provisto por `pnpm supabase start` en desarrollo local)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJpYXQiOjE2NDkyOTI4MDAsImV4cCI6MTk2NDg2ODgwMH0.placeholder_local_anon_key

# Clave de Service Role (SECRETA / PRIVADA / SERVER-ONLY).
# Saltea RLS por completo. Únicamente permitida en `src/server/supabase/admin.ts`
# con import 'server-only'. NUNCA usar en el cliente.
# (Valor por defecto provisto por `pnpm supabase start` en desarrollo local)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImlhdCI6MTY0OTI5MjgwMCwiZXhwIjoxOTY0ODY4ODAwfQ.placeholder_local_service_role_key

# ------------------------------------------------------------------------------
# 3. GOOGLE MAPS PLATFORM (Resolución D15 — Selección de pines y recorrido)
# ------------------------------------------------------------------------------
# API Key pública para Google Maps JavaScript API (@vis.gl/react-google-maps en src/ui/map.tsx).
# OBLIGATORIO en Google Cloud Console:
# - Restringir por HTTP Referrer: localhost:*, *.cadeapp.com/*
# - Restringir APIs a: 'Maps JavaScript API'
# - Fijar Quota Cap estricto: 300 cargas/día (para garantizar costo $0 dentro de las 10.000 cargas/mes gratuitas)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=AIzaSy_placeholder_google_maps_api_key

# ID de Mapa opcional para estilos personalizados o marcadores vectoriales avanzados
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=

# ------------------------------------------------------------------------------
# 4. WEB PUSH NOTIFICATIONS / VAPID (Fase 2 — T-202 y T-203)
# ------------------------------------------------------------------------------
# Para generar un par de claves VAPID:
# npx web-push generate-vapid-keys

# Clave pública VAPID (base64url) para suscripción en el navegador (Service Worker)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=BEl62iENgUivxCFwhmTn3VAgWh838ETdqfqWKVW74V_placeholder_vapid_public_key

# Clave privada VAPID (SECRETA / SERVER-ONLY) para firmar notificaciones en Node
VAPID_PRIVATE_KEY=placeholder_vapid_private_key

# Sujeto VAPID (correo de contacto del operador o URL según RFC 8292)
VAPID_SUBJECT=mailto:soporte@cadeapp.com

# ------------------------------------------------------------------------------
# 5. SEGURIDAD Y ANTI-FRAUDE (DNI_HMAC — T-121)
# ------------------------------------------------------------------------------
# Secreto criptográfico de servidor para calcular HMAC-SHA256 del DNI de repartidores.
# Permite deduplicar y bloquear reingresos de postulantes rechazados o suspendidos
# sin almacenar números de DNI en texto plano en la base.
# Generar con: node -e "console.log(crypto.randomBytes(32).toString('hex'))"
DNI_HMAC_SECRET=placeholder_32_bytes_hex_dni_hmac_secret_cadeapp_2026

# ------------------------------------------------------------------------------
# 6. TAREAS PROGRAMADAS Y CRON (T-104)
# ------------------------------------------------------------------------------
# Token secreto de autenticación Bearer para el Route Handler `/api/cron/sweep`.
# El cron del hosting invoca: Authorization: Bearer <CRON_SECRET>
# Purga solicitudes vencidas, elimina documentación de repartidores dados de baja > 30 días, etc.
CRON_SECRET=placeholder_random_secret_for_cron_sweep_job

# ------------------------------------------------------------------------------
# 7. OBSERVABILIDAD Y ALERTAS CRÍTICAS ($0 — DISCORD WEBHOOK / SENTRY OPCIONAL)
# ------------------------------------------------------------------------------
# URL del Webhook de Discord para alertas inmediatas de errores 500 al equipo.
# Cómo obtenerla (en 30 segundos):
# En tu servidor de Discord -> Editar Canal (#alertas-cadeapp) -> Integraciones -> Webhooks -> Nuevo Webhook -> Copiar URL del Webhook.
# 100% gratuito de por vida, sin tarjetas, sin límite de eventos y con 0 KB de sobrecarga a la PWA.
DISCORD_ERROR_WEBHOOK_URL=https://discord.com/api/webhooks/placeholder_webhook_id/placeholder_webhook_token

# (Opcional) DSN si en el futuro querés conectar Sentry o GlitchTip (dejar vacío si no se usa)
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ENVIRONMENT=development

# ------------------------------------------------------------------------------
# 8. ADAPTADORES DE DESARROLLO Y PRUEBAS (T-006, T-301, T-314)
# ------------------------------------------------------------------------------
# Adaptador de RPC para frontend:
# - 'real': utiliza Supabase RPCs reales vía PostgreSQL / Docker
# - 'fake': utiliza src/domain/testing/rpc-fake.ts (para desarrollar sin levantar base)
RPC_ADAPTER=real

# Bandera para mockear Google Maps en pruebas Playwright de CI:
# - 'false': renderiza Google Maps real
# - 'true': desacopla Google Maps y simula eventos de pin sin llamadas de red externas
NEXT_PUBLIC_ENABLE_MOCK_MAPS=false
