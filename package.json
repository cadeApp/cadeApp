{
  "name": "cadeapp",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.14.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint --dir src --file middleware.ts --max-warnings 0 && eslint --no-ignore --ext .mjs .github/workflows --max-warnings 0",
    "typecheck": "tsc --noEmit && tsc --project .github/workflows/tsconfig.json",
    "test": "vitest run && node --test .github/workflows/verify-workflows.test.mjs && node --test docs/adr/verify-adr.test.mjs",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "format": "prettier --write \"{src,tools}/**/*.{ts,tsx,mjs,css}\" middleware.ts \".github/workflows/*.mjs\"",
    "format:check": "prettier --check \"{src,tools}/**/*.{ts,tsx,mjs,css}\" middleware.ts \".github/workflows/*.mjs\"",
    "db:types": "node tools/db-types.mjs",
    "test:db": "supabase test db"
  },
  "dependencies": {
    "@supabase/ssr": "0.5.2",
    "@supabase/supabase-js": "2.116.0",
    "@tanstack/react-query": "5.103.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "0.475.0",
    "next": "14.2.35",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "server-only": "0.0.1",
    "sonner": "2.0.8",
    "tailwind-merge": "2.6.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@testing-library/react": "16.3.3",
    "@types/eslint": "8.56.12",
    "@types/node": "20.19.43",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@vitest/coverage-v8": "3.2.7",
    "autoprefixer": "10.6.1",
    "eslint": "8.57.1",
    "eslint-config-next": "14.2.35",
    "eslint-plugin-boundaries": "5.4.0",
    "eslint-plugin-cadeapp": "file:./tools/eslint-plugin-cadeapp",
    "jsdom": "26.1.0",
    "postcss": "8.5.28",
    "prettier": "3.9.8",
    "prettier-plugin-tailwindcss": "0.6.14",
    "tailwindcss": "3.4.19",
    "typescript": "5.9.3",
    "vitest": "3.2.7",
    "supabase": "2.116.0"
  },
  "pnpm": {
    "overrides": {
      "glob": "10.5.0",
      "handlebars": "4.7.9",
      "postcss": "8.5.28",
      "vite": "6.4.3"
    },
    "auditConfig": {
      "ignoreGhsas": [
        "GHSA-h25m-26qc-wcjf",
        "GHSA-q4gf-8mx6-v5v3",
        "GHSA-8h8q-6873-q5fj",
        "GHSA-c4j6-fc7j-m34r",
        "GHSA-36qx-fr4f-26g5",
        "GHSA-m99w-x7hq-7vfj",
        "GHSA-89xv-2m56-2m9x",
        "GHSA-p9j2-gv94-2wf4",
        "GHSA-p293-qw3h-jr36",
        "GHSA-2xp9-vwfh-vxw4"
      ]
    }
  }
}
